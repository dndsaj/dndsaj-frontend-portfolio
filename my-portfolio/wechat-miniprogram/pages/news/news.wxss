/* 搜索框样式 */
.search-box {
  background: #f8f8f8;
  padding: 20rpx 30rpx;
}
.search-input {
  background: #ffffff;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  padding: 15rpx 30rpx;
  box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.05);
}
.search-icon {
  width: 30rpx;
  height: 30rpx;
  margin-right: 15rpx;
}
.search-input input {
  flex: 1;
  font-size: 28rpx;
  color: #999;
}

/* 标签栏样式 */
.tab-bar {
  background: #ffffff;
  display: flex;
  padding: 20rpx 30rpx;
  gap: 60rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.tab-item {
  font-size: 32rpx;
  color: #666;
  position: relative;
  padding-bottom: 10rpx;
  transition: all 0.3s ease;
}
.tab-item.active {
  color: #ed5c23;
  font-weight: 600;
}
.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 6rpx;
  background: #ed5c23;
  border-radius: 3rpx;
}

/* 空状态 */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 50vh;
  padding: 40rpx;
  background: #f8f8f8;
}
.empty-text {
  font-size: 32rpx;
  color: #999;
}

/* 资讯列表样式 */
.news-list {
  background: #f8f8f8;
  min-height: 100vh;
  padding: 20rpx 30rpx;
}
.news-item {
  display: flex;
  flex-direction: column;
  gap: 0;
  background: #ffffff;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 25rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.03);
  transition: transform 0.2s ease;
}
.news-item:active {
  transform: scale(0.98);
}
.news-img {
  width: 100%;
  height: 380rpx;
  background: #f5f5f5;
}
.news-info {
  padding: 25rpx 25rpx 30rpx 25rpx;
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}
.news-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.news-desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.news-meta {
  display: flex;
  align-items: center;
  gap: 30rpx;
  margin-top: 10rpx;
}
.meta-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 26rpx;
  color: #999;
}
.meta-icon {
  width: 24rpx;
  height: 24rpx;
  opacity: 0.7;
}
