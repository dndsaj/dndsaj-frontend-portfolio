<!-- 搜索框（仅静态展示） -->
<view class="search-box">
  <view class="search-input">
    <image class="search-icon" src="https://img.icons8.com/material-outlined/24/999999/search--v1.png" />
    <input type="text" placeholder="输入关键字搜索……" disabled />
  </view>
</view>

<!-- 标签栏 -->
<view class="tab-bar">
  <view 
    class="tab-item {{activeTab == 'all' ? 'active' : ''}}" 
    bindtap="switchTab" 
    data-tab="all"
  >
    全部
  </view>
  <view 
    class="tab-item {{activeTab == 'hot' ? 'active' : ''}}" 
    bindtap="switchTab" 
    data-tab="hot"
  >
    本地热玩
  </view>
  <view 
    class="tab-item {{activeTab == 'campus' ? 'active' : ''}}" 
    bindtap="switchTab" 
    data-tab="campus"
  >
    校园资讯
  </view>
</view>

<!-- 内容区域：空状态提示 -->
<view wx:if="{{currentList.length === 0}}" class="empty-wrap">
  <text class="empty-text">暂无相关资讯内容</text>
</view>

<!-- 内容区域：资讯列表 -->
<view wx:else class="news-list">
  <view class="news-item" wx:for="{{currentList}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
    <image class="news-img" src="{{item.cover}}" mode="aspectFill"></image>
    <view class="news-info">
      <view class="news-title">{{item.title}}</view>
      <view class="news-desc">{{item.desc}}</view>
      <view class="news-meta">
        <view class="meta-item">
          <image class="meta-icon" src="https://img.icons8.com/material-outlined/24/999999/visible.png"></image>
          <text>{{item.readCount}}</text>
        </view>
        <view class="meta-item">
          <image class="meta-icon" src="https://img.icons8.com/material-outlined/24/999999/calendar.png"></image>
          <text>{{item.date}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
