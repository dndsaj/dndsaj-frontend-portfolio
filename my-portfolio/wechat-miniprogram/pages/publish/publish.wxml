<view class="publish-container">
  <!-- 分类选择 -->
  <view class="form-item">
    <text class="form-label">选择分类</text>
    <picker mode="selector" range="{{categoryList}}" range-key="name" bindchange="onCategoryChange">
      <view class="picker-select">
        {{selectedCategory.name || '请选择信息分类'}}
        <text class="arrow">⌄</text>
      </view>
    </picker>
  </view>

  <!-- 信息内容 -->
  <view class="form-item">
    <text class="form-label">信息内容</text>
    <textarea class="content-textarea" placeholder="请输入你要发布的信息内容..." maxlength="500" bindinput="onContentInput" value="{{content}}"></textarea>
    <view class="count-tip">{{content.length}}/500</view>
  </view>

  <!-- 上传封面图片 -->
  <view class="form-item">
    <text class="form-label">封面图片（可选）</text>
    <view class="upload-wrap">
      <view class="upload-card" wx:if="{{!coverImg}}" bindtap="uploadImage">
        <text class="upload-icon">+</text>
        <text class="upload-tip">点击上传</text>
      </view>
      <view class="img-preview" wx:if="{{coverImg}}">
        <image src="{{coverImg}}" mode="aspectFill"></image>
        <view class="del-btn" bindtap="deleteImage">×</view>
      </view>
    </view>
  </view>

  <!-- 提交按钮 -->
  <button class="submit-btn" bindtap="submitPublish" disabled="{{loading}}">
    {{loading ? '提交中...' : '提交发布'}}
  </button>
</view>
