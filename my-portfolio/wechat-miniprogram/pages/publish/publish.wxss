.publish-container{
  padding: 30rpx;
  min-height: 100vh;
  background: #f5f5f5;
  box-sizing: border-box;
}
.form-item{
  background: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
}
.form-label{
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 20rpx;
}
.picker-select{
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 70rpx;
  padding: 0 20rpx;
  border: 1rpx solid #eee;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #333;
}
.picker-select .arrow{
  color: #999;
  font-size: 32rpx;
}
.content-textarea{
  width: 100%;
  min-height: 240rpx;
  padding: 20rpx;
  box-sizing: border-box;
  border: 1rpx solid #eee;
  border-radius: 8rpx;
  font-size: 28rpx;
  line-height: 1.6;
}
.count-tip{
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}
.upload-wrap{
  display: flex;
}
.upload-card{
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #ddd;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #999;
  background: #fafafa;
}
.upload-icon{
  font-size: 48rpx;
  line-height: 1;
  margin-bottom: 8rpx;
}
.upload-tip{
  font-size: 24rpx;
}
.img-preview{
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 8rpx;
  overflow: hidden;
}
.img-preview image{
  width: 100%;
  height: 100%;
}
.img-preview .del-btn{
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 36rpx;
  height: 36rpx;
  background: rgba(0,0,0,0.6);
  color: #fff;
  border-radius: 50%;
  text-align: center;
  line-height: 36rpx;
  font-size: 24rpx;
}
.submit-btn{
  width: 100%;
  height: 80rpx;
  background: #1677ff;
  color: #fff;
  border-radius: 12rpx;
  font-size: 32rpx;
  margin-top: 30rpx;
  border: none;
}
.submit-btn[disabled]{
  background: #94c4ff;
  color: #f0f0f0;
}
