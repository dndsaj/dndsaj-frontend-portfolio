<view class="container">
  <!-- 顶部登录区域 -->
  <view class="login-header">
    <view class="avatar-wrapper">
      <image wx:if="{{userInfo.avatar}}" src="{{userInfo.avatar}}" mode="aspectFill"></image>
    </view>
    <view class="login-info">
      <view class="login-title">{{userInfo.nickname || '请点击登录'}}</view>
      <view class="login-tip">注册/登录会员享更多特权</view>
    </view>
    <button class="login-btn" wx:if="{{!userInfo.avatar}}" bindtap="handleGoLogin">立即登录</button>
  </view>

  <!-- 订单区域 -->
  <view class="card-base order-section">
    <view class="section-header">
      <text class="section-title">所有订单</text>
      <text class="link-text" bindtap="handleGoAllOrder">全部 ></text>
    </view>
    <view class="order-tabs">
      <view 
        class="order-tab-item" 
        bindtap="handleGoOrderList" 
        data-status="doing"
      >
        <view class="tab-icon doing">
          <text>⏯</text>
          <text class="badge" wx:if="{{count.doing > 0}}">{{count.doing}}</text>
        </view>
        <text>进行中</text>
      </view>
      <view 
        class="order-tab-item" 
        bindtap="handleGoOrderList" 
        data-status="done"
      >
        <view class="tab-icon done">
          <text>✅</text>
        </view>
        <text>已完成</text>
      </view>
      <view 
        class="order-tab-item" 
        bindtap="handleGoOrderList" 
        data-status="canceled"
      >
        <view class="tab-icon canceled">
          <text>➖</text>
        </view>
        <text>已取消</text>
      </view>
    </view>
  </view>

  <!-- 我的功能 -->
  <view class="card-base func-section">
    <view class="section-header">
      <text class="section-title">我的功能</text>
    </view>
    <view class="func-list">
      <view 
        class="func-item" 
        bindtap="handleGoPage" 
        data-page="message"
      >
        <view class="func-icon">
          <text>💬</text>
          <text class="badge" wx:if="{{badge.message > 0}}">{{badge.message}}</text>
        </view>
        <text>最新消息</text>
      </view>
      <view 
        class="func-item" 
        bindtap="handleGoPage" 
        data-page="subscribe"
      >
        <view class="func-icon">
          <text>📃</text>
        </view>
        <text>我的订阅</text>
      </view>
      <view 
        class="func-item" 
        bindtap="handleGoPage" 
        data-page="form"
      >
        <view class="func-icon">
          <text>📋</text>
        </view>
        <text>我的表单</text>
      </view>
    </view>
  </view>

  <!-- 联系电话 -->
  <view class="card-base phone-section">
    <text class="phone-icon">📞</text>
    <text>{{servicePhone}}</text>
  </view>

  <!-- 退出登录按钮 -->
  <button 
    class="logout-btn" 
    wx:if="{{userInfo.avatar}}" 
    bindtap="handleLogout"
  >
    退出当前登录
  </button>
</view>
