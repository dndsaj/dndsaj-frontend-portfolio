page {
  background: linear-gradient(to bottom, #f8e0d9, #ffffff);
  min-height: 100vh;
  font-size: 28rpx;
}

.container {
  padding: 0 16rpx 40rpx;
}

/* 公共卡片样式复用 */
.card-base {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 20rpx;
}

/* 公共角标样式 */
.badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 28rpx;
  height: 28rpx;
  line-height: 28rpx;
  padding: 0 6rpx;
  border-radius: 14rpx;
  background: #fff;
  color: #f15b29;
  font-size: 20rpx;
  text-align: center;
  border: 2rpx solid #f15b29;
  box-sizing: border-box;
}

/* ---------- 登录头部 ---------- */
.login-header {
  display: flex;
  align-items: center;
  padding: 60rpx 0;
  gap: 24rpx;
}

.avatar-wrapper {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #f0f0f0;
  overflow: hidden;
}

.avatar-wrapper image {
  width: 100%;
  height: 100%;
}

.login-info {
  flex: 1;
}

.login-title {
  font-size: 36rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 12rpx;
}

.login-tip {
  font-size: 28rpx;
  color: #666;
}

.login-btn {
  width: 160rpx;
  height: 60rpx;
  line-height: 60rpx;
  background: linear-gradient(to right, #f9ce87, #f7a84e);
  color: #333;
  border-radius: 30rpx;
  border: none;
  font-size: 28rpx;
  padding: 0;
  margin: 0;
}

.login-btn::after {
  border: none;
}

/* ---------- 订单区域 ---------- */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.link-text {
  font-size: 28rpx;
  color: #999;
  font-weight: normal;
}

.order-tabs {
  display: flex;
  justify-content: space-around;
}

.order-tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  width: 25%;
  font-size: 28rpx;
  color: #333;
}

.tab-icon {
  width: 70rpx;
  height: 70rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  font-size: 36rpx;
  color: #fff;
}

.tab-icon.doing {
  background: #f15b29;
}
.tab-icon.done {
  background: #f15b29;
}
.tab-icon.canceled {
  background: #f15b29;
}

/* ---------- 我的功能 ---------- */
.func-section {
  border: 2rpx solid #4080ff;
}

.func-list {
  display: flex;
  justify-content: space-around;
}

.func-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  width: 30%;
  font-size: 28rpx;
  color: #333;
}

.func-icon {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  font-size: 36rpx;
  color: #f15b29;
}

/* ---------- 联系电话 ---------- */
.phone-section {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 30rpx;
  color: #333;
}

.phone-icon {
  color: #999;
}

/* ---------- 退出登录 ---------- */
.logout-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  border: 2rpx solid #ccc;
  border-radius: 40rpx;
  background: #fff;
  color: #666;
  font-size: 30rpx;
  padding: 0;
}

.logout-btn::after {
  border: none;
}
