page {
  background-color: #f5f5f5;
  font-size: 28rpx;
  color: #333333;
}

/* 顶部搜索栏 */
.search-bar {
  background-color: #e65229;
  padding: 15rpx 20rpx 20rpx;
}
.search-input-wrap {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 50rpx;
  padding: 0 30rpx;
  height: 70rpx;
}
.search-icon {
  width: 30rpx;
  height: 30rpx;
  margin-right: 16rpx;
}
.search-input {
  flex: 1;
  font-size: 28rpx;
  line-height: 1;
}
.search-placeholder {
  color: #999999;
}

/* 使用须知 */
.notice-wrap {
  background-color: #e65229;
  padding: 0 20rpx 20rpx;
}
.notice-card {
  background: #ffffff;
  border-radius: 12rpx;
  padding: 30rpx;
  background-image: linear-gradient(#eeeeee 1px, transparent 1px), linear-gradient(90deg, #eeeeee 1px, transparent 1px);
  background-size: 50rpx 50rpx;
}
.notice-title {
  font-size: 44rpx;
  font-weight: bold;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 25rpx;
}
.title-arrow {
  width: 120rpx;
  height: 16rpx;
  background: repeating-linear-gradient(90deg, #f08960, #f08960 12rpx, transparent 12rpx, transparent 24rpx);
}
.notice-content text {
  display: block;
  font-size: 28rpx;
  line-height: 48rpx;
  margin-bottom: 15rpx;
}

/* 标签栏 */
.tab-bar {
  display: flex;
  align-items: center;
  background: #ffffff;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.06);
}
.tab-item {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  padding: 25rpx 0;
  color: #666666;
  position: relative;
  transition: all 0.3s ease;
}
.tab-item.active {
  color: #e65229;
}
.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 6rpx;
  background-color: #e65229;
}
.publish-btn {
  background: #e65229;
  color: #ffffff;
  border-radius: 6rpx;
  font-size: 28rpx;
  padding: 12rpx 25rpx;
  margin: 15rpx 20rpx;
  line-height: 1.2;
  border: none;
}
.publish-btn::after {
  border: none;
}

/* 信息列表 */
.info-list {
  background: #ffffff;
  padding: 0 20rpx 20rpx;
  min-height: 400rpx;
}
.info-card {
  display: flex;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.info-card:last-child {
  border-bottom: none;
}
.user-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: #f0f0f0;
  overflow: hidden;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.user-avatar image {
  width: 100%;
  height: 100%;
}
.info-content {
  flex: 1;
}
.user-name {
  font-size: 32rpx;
  color: #333333;
  margin-bottom: 15rpx;
  font-weight: 500;
}
.info-tag {
  display: inline-block;
  font-size: 26rpx;
  color: #e65229;
  background-color: #fff1ec;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  margin-bottom: 15rpx;
}
.info-text {
  font-size: 30rpx;
  color: #444444;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.info-single-img {
  width: 100%;
  margin-top: 20rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background-color: #f5f5f5;
}
.single-img {
  width: 100%;
  height: 320rpx;
  display: block;
}
.empty-tip {
  text-align: center;
  color: #999999;
  font-size: 28rpx;
  padding: 100rpx 0;
}

/* 悬浮按钮 */
.float-btns {
  position: fixed;
  right: 20rpx;
  bottom: 120rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  z-index: 999;
}
.float-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  transition: transform 0.2s ease;
}
.float-btn:active {
  transform: scale(0.95);
}
.backtop-btn {
  background-color: #e65229;
}
.backtop-btn image {
  width: 40rpx;
  height: 40rpx;
}
