<view class="detail-page">
  <!-- 商品头部大图 -->
  <image class="banner-img" src="{{detailInfo.img}}" mode="aspectFit"></image>

  <!-- 商品标题/名称区域 -->
  <view class="title-wrap">
    <text class="main-title">{{detailInfo.name}}</text>
    <view class="meta-info">
      <!-- 如果有发布时间就保留，不需要可以删掉这个节点 -->
      <text class="publish-date">价格：{{detailInfo.date}}</text>
    </view>
    <!-- 添加商品价格展示 -->
    <text class="goods-price">¥{{detailInfo.price}}</text>
  </view>

  <!-- 商品描述区域 -->
  <view class="content-wrap">
    <text class="goods-desc">{{detailInfo.desc}}</text>
  </view>

  <!-- 底部固定操作栏，保留你现有的点赞收藏功能 -->
  <view class="bottom-bar">
    <view class="action-item">
      <text class="icon">👍</text>
      <text>{{likeNum}}</text>
    </view>
    <view class="action-item">
      <text class="icon">⭐</text>
      <text>{{collectNum}}</text>
    </view>
    <view class="action-item">
      <text class="icon">💬</text>
      <text>{{commentNum}}</text>
    </view>
    <view class="share-btn">
      <text>电话联系</text>
    </view>
  </view>
</view>
